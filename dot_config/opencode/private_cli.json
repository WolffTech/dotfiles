{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "system"
  },
  "keybinds": {
    "agent.list": "tab",
    "agent.cycle": "none",
    "agent.cycle.reverse": "none"
  },
  "diffs": {
    "wrap": "word"
  },
  "prompt": {
    "paste": "full"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "hide"
  },
  "animations": true
}
