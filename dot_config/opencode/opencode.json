{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "build",
  "plugins": [
    "@slkiser/opencode-quota@latest"
  ],
  "agents": {
    "general": {
      "model": "openai/gpt-5.6-terra"
    },
    "explore": {
      "model": "openai/gpt-5.6-terra"
    },
    "plan": {
      "disabled": true
    },
    "build": {
      "color": "#d20f39"
    }
  },
  "providers": {
    "wolff-spark-01": {
      "package": "aisdk:@ai-sdk/openai-compatible",
      "name": "Wolff.Tech",
      "settings": {
        "baseURL": "https://wolff-spark-01.cymric-stargazer.ts.net:8443/v1"
      },
      "models": {
        "glm-5.3-flash": {
          "name": "GLM-5.3-Flash"
        }
      }
    },
    "wolff-spark-01-qwen": {
      "package": "aisdk:@ai-sdk/openai-compatible",
      "name": "Wolff.Tech Qwen",
      "settings": {
        "baseURL": "https://wolff-spark-01.cymric-stargazer.ts.net:8444/v1"
      },
      "models": {
        "qwen3.8-flash-next": {
          "name": "Qwen3.8-Flash-Next",
          "limit": {
            "context": 32768,
            "output": 8192
          }
        }
      }
    }
  },
  "mcp": {
    "servers": {
      "gh_grep": {
        "type": "remote",
        "url": "https://mcp.grep.app",
        "disabled": false
      },
      "microsoft-learn": {
        "type": "remote",
        "url": "https://learn.microsoft.com/api/mcp",
        "disabled": false
      }
    }
  }
}
